# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App / session ----
# 32+ char random string. Used to sign session JWTs (jose HS256).
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=12
# Public base URL used inside notification links
APP_BASE_URL=http://localhost:3000

# ---- Supabase Storage (KYC docs) ----
KYC_BUCKET=kyc-documents

# ---- Security ----
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
